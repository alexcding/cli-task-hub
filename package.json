{
  "name": "taskhub",
  "productName": "TaskHub",
  "version": "1.0.0",
  "description": "Track Jira tickets and GitHub PRs from your Mac menu bar",
  "author": "alexcding",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen:swift-routes": "node scripts/gen-swift-routes.mjs",
    "check:swift-routes": "node scripts/gen-swift-routes.mjs --check",
    "start": "node src/server/app.js",
    "test": "node --test --test-force-exit 'test/**/*.test.js'",
    "dev": "./dev.sh",
    "dev:server": "node --watch src/server/app.js",
    "gen-icon": "node scripts/gen-icon.js"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.12.0",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "express": "^5.2.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "diff2html": "^3.4.56",
    "highlight.js": "^11.11.1"
  }
}
