// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = TaskHub
PRODUCT_DISPLAY_NAME = TaskHub Native
PRODUCT_BUNDLE_IDENTIFIER = tv.accedo.taskhub.native
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/TaskHub.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/TaskHub.entitlements
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
ENABLE_APP_SANDBOX = NO
SWIFT_VERSION = 6.0
ALWAYS_SEARCH_USER_PATHS = NO
